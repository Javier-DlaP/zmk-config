#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

#define DEFAULT 0
#define F_NUM_PAD 1
#define NUM_PAD 2
#define SPECIAL 3

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {

						label = "DEFAULT";
                        bindings = <
   	//,-----------------------------------------------------------------.                        ,-----------------------------------------------------------------.
		  &kp ESC      &kp Q 	  &kp W 	 &kp E 		&kp R 	   &kp T   			        		   &kp Y 	  &kp U  	 &kp I     	&kp O  	   &kp P   &kp BSPC
	//|----------+----------+----------+----------+----------+----------|                        |----------+----------+----------+----------+----------+----------|
		  &kp TAB 	   &kp A 	  &kp S 	 &kp D 		&kp F 	   &kp G   	 					  	   &kp H 	  &kp J  	 &kp K      &kp L  	&kp SEMI   &kp LGUI
	//|----------+----------+----------+----------+----------+----------|                        |----------+----------+----------+----------+----------+----------|
   		&kp LCTRL      &kp Z 	  &kp X 	 &kp C 		&kp V 	   &kp B   							   &kp N 	  &kp M  &kp COMMA 	  &kp DOT 	&kp LBKT   &kp RBKT
	//|----------+----------+----------+----------+----------+----------+----------|  |----------+----------+----------+----------+----------+----------+----------|
                  								  &kp LSHFT &mo F_NUM_PAD &kp SPACE    &kp ENTER &mo NUM_PAD   &kp RALT
												//`--------------------------------'  `--------------------------------'
                        >;
                };

                f_num_pad_layer {

						label = "F_NUM_PAD";
                        bindings = <
   	//,-----------------------------------------------------------------.                        ,-----------------------------------------------------------------.
	   		&none 	 &kp F12 	 &kp F7 	&kp F8 	   &kp F9	   &none   							   &none	  &none		 &none		&none	   &none    &kp DEL
	//|----------+----------+----------+----------+----------+----------|                        |----------+----------+----------+----------+----------+----------|
		 &kp CAPS  	 &kp F11 	 &kp F4 	&kp F5 	   &kp F6	   &none   	 					    &kp LEFT   &kp DOWN  	&kp UP 	&kp RIGHT	   &none   &kp LGUI
	//|----------+----------+----------+----------+----------+----------|                        |----------+----------+----------+----------+----------+----------|
   		&kp LCTRL    &kp F10 	 &kp F1 	&kp F2 	   &kp F3	   &none  							   &none	  &none		 &none		&none	   &none	  &none
	//|----------+----------+----------+----------+----------+----------+----------|  |----------+----------+----------+----------+----------+----------+----------|
                  								  	&kp LSHFT 	   &none  &kp SPACE    &kp ENTER &mo SPECIAL   &kp LALT
												//`--------------------------------'  `--------------------------------'
                        >;
                };

                num_pad_layer {
						label = "NUM_PAD";
                        bindings = <
   	//,-----------------------------------------------------------------.                        ,-----------------------------------------------------------------.
		&kp EQUAL  &kp SLASH 	 &kp N7 	&kp N8 	   &kp N9  &kp MINUS   			       			   &none	  &none	&kp RA(N1)	 &kp EXCL	  &kp AT	&kp DEL
	//|----------+----------+----------+----------+----------+----------|                        |----------+----------+----------+----------+----------+----------|
		 &kp CAPS 	&kp STAR 	 &kp N4 	&kp N5 	   &kp N6 	&kp PLUS   	 						   &none   &kp NUHS	  &kp APOS	 &kp NUBS  &kp MINUS   &kp LGUI
	//|----------+----------+----------+----------+----------+----------|                        |----------+----------+----------+----------+----------+----------|
        &kp LCTRL     &kp N0 	 &kp N1 	&kp N2 	   &kp N3 	 &kp DOT   							   &none   &none &kp RA(SLASH) &kp QMARK	&kp LPAR   &kp RPAR
	//|----------+----------+----------+----------+----------+----------+----------|  |----------+----------+----------+----------+----------+----------+----------|
                  								   &kp LSHFT &mo SPECIAL  &kp SPACE    	&kp ENTER 	   &none   &kp RALT
												//`--------------------------------'  `--------------------------------'
                        >;
                };


                special_layer {
						label = "SPECIAL";
                        bindings = <
   	//,-----------------------------------------------------------------.                        ,-----------------------------------------------------------------.
			&none	   &none	  &none		 &none		&none  &kp PSCRN			  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &kp C_VOL_DN &kp C_VOL_UP
	//|----------+----------+----------+----------+----------+----------|                        |----------+----------+----------+----------+----------+----------|
			&none	   &none   &kp HOME  &kp PG_DN 	&kp PG_UP 	 &kp END   	 						   &none	  &none		 &none		&none &kp C_PREV &kp C_NEXT
	//|----------+----------+----------+----------+----------+----------|                        |----------+----------+----------+----------+----------+----------|
	&kp LG(SPACE)	   &none	  &none		 &none		&none	   &none   						  &bt BT_CLR	  &none		 &none		&none &kp C_MUTE   &kp C_PP
	//|----------+----------+----------+----------+----------+----------+----------|  |----------+----------+----------+----------+----------+----------+----------|
                  								   	&kp LSHFT      &none  &kp SPACE   	&kp ENTER 	   &none   &kp RALT
												//`--------------------------------'  `--------------------------------'
                        >;
                };
        };
};
